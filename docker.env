# Docker test environment configuration
# Use this file on builder VM to test All-Docker Architecture
# Do NOT use for production - use zones.json instead

# Use Docker-local zones configuration (container IPs 172.20.0.x)
ZONES_CONFIG=/etc/dnsmasq-ui/zones-docker.json

# dnsmasq records file in container
DNSMASQ_RECORDS_FILE=/etc/dnsmasq.d/local-records.conf

# SSH settings for container-based DNS servers
SSH_KEY=/root/.ssh/id_rsa
SSH_USER=root

# Flask environment
FLASK_ENV=production
