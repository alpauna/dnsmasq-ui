#cloud-config
# Cloud-init user-data for dnsmasq-ui DNS server nodes
# Generated by setup.sh

hostname: __HOSTNAME__
fqdn: __HOSTNAME__.example.com

users:
  - name: debian
    gecos: Debian User
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - __SSH_PUBLIC_KEY__

packages:
  - dnsmasq
  - keepalived
  - openssh-server
  - docker.io
  - git
  - curl
  - iproute2
  - net-tools
  - python3-docker
  - python3-dotenv

package_update: true
package_upgrade: true

# Run commands to enable services
runcmd:
  - systemctl enable dnsmasq
  - systemctl enable keepalived
  - systemctl enable docker
  - systemctl enable ssh

write_files:
  - path: /root/.ssh/authorized_keys
    permissions: '0600'
    content: |
      __SSH_PUBLIC_KEY__

# Set timezone
timezone: UTC
