// Managed by ansible/bind9-setup.yml -- structural options only. Zone
// content itself always comes from app-multi-zone.py's generator, never
// from this playbook (see the "static-content landmine" this deliberately
// avoids, documented in ansible/dnsmasq-setup.yml's own history).
options {
	directory "/var/cache/bind";

	forwarders {
{% for dns in upstream_dns %}
		{{ dns }};
{% endfor %}
	};

	dnssec-validation auto;

	// any/any matches dnsmasq's actual current behavior (wildcard bind on
	// 0.0.0.0/::, confirmed live via `ss -tulnp` against the real
	// servers) -- not a widened posture. This also means a WireGuard
	// tunnel IP is automatically covered with no config change needed
	// when wg0 comes up, unlike dnsmasq's current setup which needs an
	// explicit interface=wg0/listen-address stanza
	// (deploy_wg_dnsmasq_config() in app-multi-zone.py). The actual
	// access boundary is allow-recursion/allow-query below, not this.
	listen-on { any; };
	listen-on-v6 { any; };
	allow-recursion { {{ allowed_query_networks | join('; ') }}; };
	// LAN-only by default -- mgmt.alshowto.com is the one zone meant to
	// be publicly reachable (NS-delegated via Pangolin's raw TCP/UDP:53
	// passthrough, which can't filter by hostname/zone, only by port),
	// so it gets an explicit allow-query{any} override in its own zone
	// stanza in named.conf.local.j2. Without this default, that same
	// public reachability would expose every zone this process serves
	// -- ad/cld/internal.alshowto.com and all 5 reverse zones -- not
	// just the one meant to be public. Confirmed live (2026-08-13):
	// internal.alshowto.com answered queries through the public Pangolin
	// path before this was scoped down.
	allow-query { {{ allowed_query_networks | join('; ') }}; };
};
