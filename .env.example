# Environment Variables for dnsmasq-ui Infrastructure
# ======================================================
# Copy this to .env and fill in your actual values
# Never commit .env file - add to .gitignore

# Proxmox Infrastructure
PROXMOX_HOST=192.168.7.13
PROXMOX_USER=root
PROXMOX_PASSWORD=your_proxmox_password
PROXMOX_NODE=pve3
PROXMOX_SSH_KEY=~/.ssh/id_rsa

# Proxmox VM Configuration
VM_ID=9100
VM_NAME=builder
VM_STORAGE=c-vm
VM_NETWORK_BRIDGE=vmbr0
VM_CORES=4
VM_MEMORY=4096
VM_DISK_SIZE=30
VM_MAC_ADDRESS=bc:24:11:65:e1:01

# Cloud-init Configuration
CLOUD_INIT_USER=debian
CLOUD_INIT_HOSTNAME=builder
CLOUD_INIT_DOMAIN=ap.alshowto.com
CLOUD_INIT_IP=192.168.0.253/23
CLOUD_INIT_GATEWAY=192.168.0.1
CLOUD_INIT_DNS_PRIMARY=192.168.0.250
CLOUD_INIT_DNS_SECONDARY=1.1.1.1
CLOUD_INIT_DNS_TERTIARY=8.8.8.8

# SSH Configuration
SSH_USER=debian
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_KEY_PASSPHRASE=

# dnsmasq-ui dashboard (192.168.0.233:5000) — for local testing/debugging
# only, so the admin password doesn't have to be typed into terminal
# commands (bash history, ps aux) each session. Two separate secrets:
DNSMASQ_UI_ADMIN_PASSWORD=
# Unlocks the device-credentials vault (switch enable/login passwords),
# independent from the dashboard login above.
DNSMASQ_UI_VAULT_PASSWORD=

# DNS Server Configuration (for deployment)
DNS01_IP=192.168.0.231
DNS01_USER=debian
DNS02_IP=192.168.0.232
DNS02_USER=debian
DNS03_IP=192.168.0.233
DNS03_USER=debian

# Network Configuration
NETWORK_GATEWAY=192.168.0.1
NETWORK_SUBNET=/23
NETWORK_VLAN_ID=0
NETWORK_VLAN_TAG=off

# Storage Configuration
STORAGE_POOL=c-vm
STORAGE_TYPE=dir
STORAGE_PATH=/mnt/storage/vms
STORAGE_CONTENT=images,rootdir

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=2  # 2 AM daily
BACKUP_COMPRESS=gzip

# Ansible Configuration
ANSIBLE_INVENTORY=ansible/inventory.ini
ANSIBLE_VAULT_FILE=ansible/vault.yml
ANSIBLE_BECOME_PASSWORD=
ANSIBLE_HOST_KEY_CHECKING=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/dnsmasq-ui/deployment.log

# Feature Flags
ENABLE_HA=true
ENABLE_REPLICATION=false
ENABLE_CLUSTERING=true
ENABLE_BACKUPS=true
ENABLE_SNAPSHOTS=true

# Email Notifications
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=
SLACK_USERNAME=dnsmasq-ui-bot

# API Keys
PAGERDUTY_KEY=
GRAFANA_API_KEY=
PROMETHEUS_URL=

# ACME DNS-01 challenge publishing (see /api/acme-challenge and the Config
# page's "ACME Hook Keys" section). ACME_DNS_BACKEND selects where the
# _acme-challenge TXT record actually gets published:
#   cloudflare (default) - via Cloudflare's API, since Cloudflare is
#     alshowto.com's real authoritative public DNS today; requires an
#     API token scoped to Zone:DNS:Edit on that zone, plus the zone's ID
#   local - written into zones.json and pushed to the dnsmasq servers
#     like any other record; only useful once alshowto.com's authoritative
#     DNS moves onto these servers themselves
ACME_DNS_BACKEND=cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Advanced Configuration
DEBUG_MODE=false
DRY_RUN=false
PARALLEL_DEPLOYMENT=true
TIMEOUT_SECONDS=300
RETRY_ATTEMPTS=3
